# Copy to backend/.env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-value-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=3600
JWT_ISSUER=secure-notes-api
JWT_AUDIENCE=secure-notes-client

BCRYPT_ROUNDS=12

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Login/register attempts allowed per IP per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Used only by `npm run admin:create`
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Used only by `npm run db:seed` (development data)
# SEED_PASSWORD=Password123

# Used only by the test suite (each test file creates and drops its own database)
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
